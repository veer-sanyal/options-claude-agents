# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored. Never commit real keys.

# From the Alpaca dashboard with the PAPER account selected (key id starts with PK).
ALPACA_API_KEY=PK_your_paper_key_id_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Claude runs through Claude Code on your subscription: no Anthropic API key.
# Only needed if a scheduled (cron) run can't find or log in to Claude Code:
# CLAUDE_BIN=/full/path/from/which/claude
# CLAUDE_CODE_OAUTH_TOKEN=paste_the_token_from_claude_setup-token_here

# Optional overrides (defaults live in papertrader/config.py):
# WATCHLIST=AAPL,MSFT,NVDA,GOOGL,AMZN,META,AVGO,AMD,CRM,ORCL,ADBE,NOW,SPY,QQQ
# MAX_POSITION_PCT=0.10
# MAX_INVESTED_PCT=0.80
# MAX_ORDER_DOLLARS=5000
# MAX_ORDERS_PER_RUN=5
# DAILY_LOSS_LIMIT_PCT=0.03
# MAX_DRAWDOWN_PCT=0.15
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high
# CLAUDE_TIMEOUT_S=600
